{
  "name": "subitems-and-order",
  "feature": "pauta-revelavel",
  "url": "http://127.0.0.1:5280",
  "viewport": { "width": 1280, "height": 860 },
  "timeout": 10000,
  "steps": [
    { "do": "goto", "url": "/#/rundowns" },
    { "do": "click", "target": "role=button[name=\"Nova pauta\"][exact]>>first" },
    { "do": "fill", "target": "label=Nome da pauta", "value": "Pauta de tópicos" },
    { "do": "click", "target": "role=button[name=\"Criar pauta\"]", "boundary": { "method": "POST", "url": "/\\/api\\/rundowns$/", "status": 201 } },
    { "do": "expect", "text": "Folha em branco." },
    { "do": "click", "target": "role=button[name=\"Clique para escrever, cole (Ctrl+V) ou solte um arquivo\"]" },
    { "do": "type", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "value": "Abertura", "boundary": { "method": "PUT", "url": "/\\/api\\/rundowns\\/.+\\/sheet/", "status": 200 }, "boundary_wait": 5000 },

    { "do": "press", "key": "Tab", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "ac": "AC-pauta-revelavel-40", "note": "first block: no topic right above" },
    { "do": "expect", "target": "testid=toast", "contains": "Para virar sub-item, o bloco precisa de um tópico logo acima.", "ac": "AC-pauta-revelavel-40" },

    { "do": "press", "key": "Enter", "target": "role=textbox[name=\"Texto do bloco\"]>>last" },
    { "do": "press", "key": "Enter", "target": "role=textbox[name=\"Texto do bloco\"]>>last" },
    { "do": "type", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "value": "Ponto da abertura" },
    { "do": "press", "key": "Tab", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "ac": "AC-pauta-revelavel-40" },
    { "do": "eval", "expression": "document.querySelectorAll('[data-testid=sheet-block]')[1].dataset.depth + ':' + document.querySelectorAll('[data-testid=sheet-block]')[1].dataset.size", "equals": "1:small", "ac": "AC-pauta-revelavel-40", "note": "indented one level and one size down" },
    { "do": "expect", "target": "testid=block-bullet>>first", "text": "•", "ac": "AC-pauta-revelavel-41" },

    { "do": "press", "key": "Enter", "target": "role=textbox[name=\"Texto do bloco\"]>>last" },
    { "do": "press", "key": "Enter", "target": "role=textbox[name=\"Texto do bloco\"]>>last" },
    { "do": "type", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "value": "Detalhe" },
    { "do": "press", "key": "Tab", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "ac": "AC-pauta-revelavel-40" },
    { "do": "expect", "target": "testid=block-bullet>>last", "text": "◦", "ac": "AC-pauta-revelavel-41" },

    { "do": "press", "key": "Enter", "target": "role=textbox[name=\"Texto do bloco\"]>>last" },
    { "do": "press", "key": "Enter", "target": "role=textbox[name=\"Texto do bloco\"]>>last" },
    { "do": "type", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "value": "Fechamento" },
    { "do": "press", "key": "Tab", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "ac": "AC-pauta-revelavel-40", "note": "level 2 next to level 2: past the third level" },
    { "do": "expect", "target": "testid=toast", "contains": "A pauta vai até 3 níveis: o tópico e dois níveis de sub-item.", "ac": "AC-pauta-revelavel-40" },
    { "do": "press", "key": "Shift+Tab", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "ac": "AC-pauta-revelavel-40" },
    { "do": "press", "key": "Alt+ArrowLeft", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "ac": "AC-pauta-revelavel-40" },
    { "do": "eval", "expression": "[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.dataset.depth + ':' + b.querySelector('[data-testid=block-text]').textContent).join('|')", "equals": "0:Abertura|1:Ponto da abertura|2:Detalhe|0:Fechamento", "ac": ["AC-pauta-revelavel-40", "AC-pauta-revelavel-11"] },

    { "do": "press", "key": "Alt+ArrowUp", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "boundary": { "method": "PUT", "url": "/\\/api\\/rundowns\\/.+\\/sheet/", "status": 200 }, "boundary_wait": 5000, "ac": ["AC-pauta-revelavel-44", "AC-pauta-revelavel-42"] },
    { "do": "eval", "expression": "[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.dataset.depth + ':' + b.querySelector('[data-testid=block-text]').textContent).join('|')", "equals": "0:Fechamento|0:Abertura|1:Ponto da abertura|2:Detalhe", "ac": ["AC-pauta-revelavel-44", "AC-pauta-revelavel-42"], "note": "jumped over the whole Abertura topic" },
    { "do": "expect", "target": "testid=sheet-announcer", "text": "Bloco movido para a posição 1 de 4.", "ac": "AC-pauta-revelavel-44" },
    { "do": "expect", "target": "testid=toast", "contains": "Bloco movido. A ordem da coluna é a ordem de revelar.", "ac": "AC-pauta-revelavel-44" },
    { "do": "click", "target": "role=button[name=\"Desfazer\"]", "boundary": { "method": "PUT", "url": "/\\/api\\/rundowns\\/.+\\/sheet/", "status": 200 }, "boundary_wait": 5000, "ac": "AC-pauta-revelavel-44" },
    { "do": "eval", "expression": "[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.dataset.depth + ':' + b.querySelector('[data-testid=block-text]').textContent).join('|')", "equals": "0:Abertura|1:Ponto da abertura|2:Detalhe|0:Fechamento", "ac": "AC-pauta-revelavel-44" },
    { "do": "expect", "target": "testid=sheet-announcer", "text": "Ordem anterior de volta.", "ac": "AC-pauta-revelavel-44" },

    { "do": "wait", "ms": 1500 },
    { "do": "reload" },
    { "do": "wait", "target": "role=textbox[name=\"Texto do bloco\"]>>nth=3" },
    { "do": "eval", "expression": "[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.dataset.depth + ':' + b.querySelector('[data-testid=block-text]').textContent).join('|')", "equals": "0:Abertura|1:Ponto da abertura|2:Detalhe|0:Fechamento", "ac": ["AC-pauta-revelavel-40", "AC-pauta-revelavel-44"], "note": "order and levels survive the reload" },

    { "do": "click", "target": "role=textbox[name=\"Texto do bloco\"]>>first" },
    { "do": "press", "key": "Escape", "ac": "AC-pauta-revelavel-53" },
    { "do": "press", "key": "Delete", "ac": "AC-pauta-revelavel-45" },
    { "do": "expect", "target": "role=dialog[name=\"Apagar bloco?\"]", "contains": "Os sub-itens dele sobem um nível.", "ac": ["AC-pauta-revelavel-45", "AC-pauta-revelavel-42"] },
    { "do": "expect", "target": "role=dialog[name=\"Apagar bloco?\"]", "contains": "Não dá para desfazer.", "ac": "AC-pauta-revelavel-45" },
    { "do": "click", "target": "role=button[name=\"Cancelar\"]", "ac": "AC-pauta-revelavel-45" },
    { "do": "expect", "target": "role=textbox[name=\"Texto do bloco\"]", "count": 4, "ac": "AC-pauta-revelavel-45" },
    { "do": "press", "key": "Delete", "ac": "AC-pauta-revelavel-45" },
    { "do": "expect", "visible": "role=dialog[name=\"Apagar bloco?\"]", "ac": "AC-pauta-revelavel-45" },
    { "do": "press", "key": "Escape", "ac": "AC-pauta-revelavel-45" },
    { "do": "expect", "hidden": "role=dialog[name=\"Apagar bloco?\"]", "ac": "AC-pauta-revelavel-45" },
    { "do": "expect", "target": "role=textbox[name=\"Texto do bloco\"]", "count": 4, "ac": "AC-pauta-revelavel-45" },
    { "do": "press", "key": "Delete", "ac": "AC-pauta-revelavel-45" },
    { "do": "click", "target": "css=[role=\"dialog\"] button.btn-danger", "note": "the confirm of \"Apagar bloco?\"; each trash is also labelled \"Apagar bloco\"", "boundary": { "method": "PUT", "url": "/\\/api\\/rundowns\\/.+\\/sheet/", "status": 200 }, "boundary_wait": 5000, "ac": ["AC-pauta-revelavel-45", "AC-pauta-revelavel-42"] },
    { "do": "eval", "expression": "[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.dataset.depth + ':' + b.querySelector('[data-testid=block-text]').textContent).join('|')", "equals": "0:Ponto da abertura|1:Detalhe|0:Fechamento", "ac": "AC-pauta-revelavel-42", "note": "the sub-items moved one level up" },

    { "do": "wait", "ms": 1500 },
    { "do": "reload" },
    { "do": "wait", "target": "role=textbox[name=\"Texto do bloco\"]>>nth=2" },
    { "do": "eval", "expression": "[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.dataset.depth + ':' + b.querySelector('[data-testid=block-text]').textContent).join('|')", "equals": "0:Ponto da abertura|1:Detalhe|0:Fechamento", "ac": ["AC-pauta-revelavel-42", "AC-pauta-revelavel-45"] },

    { "do": "eval", "expression": "(async () => { const id = decodeURIComponent(location.hash.split('/')[2]); const response = await fetch('/api/rundowns/' + id + '/sheet', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ blocks: [{ key: 'loose', kind: 'text', depth: 1, content: [{ text: 'solto' }], mediaPath: '', mediaName: '', size: 'small', fontPx: 22, plannedVisible: false, takeVisible: false, revealStep: null, collapsed: false }] }) }); return response.status; })()", "equals": 422, "ac": "AC-pauta-revelavel-42", "note": "a first block below level 0 is refused by the server (RULE-pauta-revelavel-04)" },
    { "do": "reload" },
    { "do": "wait", "target": "role=textbox[name=\"Texto do bloco\"]>>nth=2" },
    { "do": "eval", "expression": "[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.dataset.depth + ':' + b.querySelector('[data-testid=block-text]').textContent).join('|')", "equals": "0:Ponto da abertura|1:Detalhe|0:Fechamento", "ac": "AC-pauta-revelavel-42", "note": "the refused tree wrote nothing" },
    { "do": "screenshot", "name": "subitems-and-order" }
  ]
}
