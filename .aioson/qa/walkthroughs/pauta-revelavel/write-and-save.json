{
  "name": "write-and-save",
  "feature": "pauta-revelavel",
  "url": "http://127.0.0.1:5280",
  "viewport": { "width": 1280, "height": 860 },
  "timeout": 10000,
  "steps": [
    { "do": "goto", "url": "/", "ac": "AC-pauta-revelavel-01" },
    { "do": "expect", "url": "/#\\/rundowns$/", "ac": "AC-pauta-revelavel-01", "note": "fresh app dir: no rundown yet" },
    { "do": "expect", "text": "Nenhuma pauta ainda.", "ac": "AC-pauta-revelavel-01" },
    { "do": "click", "target": "role=button[name=\"Criar a primeira pauta\"]", "ac": "AC-pauta-revelavel-02" },
    { "do": "click", "target": "role=button[name=\"Criar pauta\"]", "ac": "AC-pauta-revelavel-02", "note": "empty name" },
    { "do": "expect", "text": "Dê um nome à pauta, por exemplo \"Episódio 12: filas\".", "ac": "AC-pauta-revelavel-02" },
    { "do": "fill", "target": "label=Nome da pauta", "value": "Episódio do passeio" },
    { "do": "click", "target": "role=button[name=\"Criar pauta\"]", "boundary": "POST /api/rundowns -> 201", "ac": "AC-pauta-revelavel-02" },
    { "do": "expect", "text": "Folha em branco.", "ac": "AC-pauta-revelavel-02" },
    { "do": "expect", "target": "testid=sheet-counter", "contains": "/0\\s+de\\s+0/", "ac": "AC-pauta-revelavel-08" },
    { "do": "click", "target": "role=button[name=\"Clique para escrever, cole (Ctrl+V) ou solte um arquivo\"]", "ac": "AC-pauta-revelavel-10" },
    { "do": "type", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "value": "Primeiro bloco do passeio", "boundary": { "method": "PUT", "url": "/\\/api\\/rundowns\\/.+\\/sheet/", "status": 200 }, "boundary_wait": 5000, "ac": ["AC-pauta-revelavel-09", "AC-pauta-revelavel-10"] },
    { "do": "expect", "target": "testid=sheet-counter", "contains": "/1\\s+de\\s+1/", "ac": ["AC-pauta-revelavel-08", "AC-pauta-revelavel-10"] },
    { "do": "press", "key": "Enter", "target": "role=textbox[name=\"Texto do bloco\"]>>last" },
    { "do": "press", "key": "Enter", "target": "role=textbox[name=\"Texto do bloco\"]>>first", "ac": "AC-pauta-revelavel-11" },
    { "do": "expect", "target": "role=textbox[name=\"Texto do bloco\"]", "count": 2, "ac": "AC-pauta-revelavel-11" },
    { "do": "type", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "value": "Segundo bloco do passeio", "ac": "AC-pauta-revelavel-11" },
    { "do": "wait", "ms": 1500 },
    { "do": "expect", "target": "testid=save-state", "contains": "/Salvo às \\d{2}:\\d{2}/", "ac": ["AC-pauta-revelavel-08", "AC-pauta-revelavel-09"] },
    { "do": "reload" },
    { "do": "expect", "target": "role=textbox[name=\"Texto do bloco\"]>>first", "contains": "Primeiro bloco do passeio", "ac": "AC-pauta-revelavel-09" },
    { "do": "expect", "target": "role=textbox[name=\"Texto do bloco\"]>>last", "contains": "Segundo bloco do passeio", "ac": "AC-pauta-revelavel-09" },
    { "do": "eval", "expression": "Object.keys(window.localStorage).length", "equals": 0, "ac": "AC-pauta-revelavel-09", "note": "nothing of the product in localStorage" },
    { "do": "goto", "url": "/#/board/antigo", "ac": "AC-pauta-revelavel-12" },
    { "do": "expect", "url": "/#\\/rundowns$/", "ac": "AC-pauta-revelavel-12" },
    { "do": "expect", "target": "css=.rundown-row", "contains": "2 blocos", "ac": "AC-pauta-revelavel-06" },
    { "do": "eval", "expression": "!/Bancada|Palco|Acervo|relatório|Entrar no ar|cronômetro/i.test(document.body.innerText)", "equals": true, "ac": "AC-pauta-revelavel-49" },
    { "do": "goto", "url": "about:blank" },
    { "do": "goto", "url": "/", "ac": "AC-pauta-revelavel-01" },
    { "do": "expect", "url": "/#\\/rundown\\//", "ac": "AC-pauta-revelavel-01", "note": "a bare address reopens the last rundown" },
    { "do": "expect", "target": "label=Nome da pauta", "value": "Episódio do passeio", "ac": "AC-pauta-revelavel-01" }
  ]
}
