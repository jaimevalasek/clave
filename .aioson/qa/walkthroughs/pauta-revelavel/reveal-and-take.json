{
  "name": "reveal-and-take",
  "feature": "pauta-revelavel",
  "url": "http://127.0.0.1:5280",
  "viewport": { "width": 1280, "height": 860 },
  "timeout": 10000,
  "steps": [
    {"do":"goto","url":"/#/rundowns"},
    {"do":"click","target":"role=button[name=\"Nova pauta\"][exact]>>first"},
    {"do":"fill","target":"label=Nome da pauta","value":"Roteiro de dez blocos"},
    {"do":"click","target":"role=button[name=\"Criar pauta\"]","boundary":{"method":"POST","url":"/\\/api\\/rundowns$/","status":201}},
    {"do":"expect","text":"Folha em branco."},
    {"do":"press","key":"PageDown","ac":"AC-pauta-revelavel-22"},
    {"do":"expect","target":"testid=toast","contains":"A pauta está vazia. Cole ou escreva o primeiro bloco.","ac":"AC-pauta-revelavel-22"},
    {"do":"eval","expression":"(async () => { const id = decodeURIComponent(location.hash.split('/')[2]); const rows = [['Abertura', 0, 1], ['Tema do dia', 0, 0], ['Contexto', 1, 0], ['Detalhe do contexto', 2, 0], ['Exemplo', 1, 0], ['Segunda parte', 0, 0], ['Ponto A', 1, 0], ['Ponto B', 1, 0], ['Pergunta ao chat', 0, 0], ['Encerramento', 0, 0]]; const blocks = rows.map(([text, depth, on], index) => ({ key: 'k' + index, kind: 'text', depth, content: [{ text }], mediaPath: '', mediaName: '', size: depth ? 'small' : 'medium', fontPx: depth ? 22 : 30, plannedVisible: Boolean(on), takeVisible: Boolean(on), revealStep: null, collapsed: false })); const response = await fetch('/api/rundowns/' + id + '/sheet', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ blocks }) }); return response.status; })()","equals":200,"note":"ten blocks with sub-items, only Abertura planned visible"},
    {"do":"reload"},
    {"do":"wait","target":"testid=sheet-ruler"},
    {"do":"expect","target":"testid=sheet-counter","contains":"1 de 10","ac":"AC-pauta-revelavel-31"},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura","ac":"AC-pauta-revelavel-27"},
    {"do":"eval","expression":"document.body.innerHTML.includes('Encerramento')","equals":false,"ac":"AC-pauta-revelavel-27","note":"a hidden block is not in the page"},
    {"do":"expect","visible":"role=button[name=\"Ocultar último\"]","ac":"AC-pauta-revelavel-08"},
    {"do":"expect","visible":"role=button[name=\"Revelar próximo\"]","ac":"AC-pauta-revelavel-08"},
    {"do":"expect","visible":"role=button[name=\"Preparo\"]","ac":"AC-pauta-revelavel-08"},
    {"do":"expect","visible":"role=button[name=\"Nova tomada\"]","ac":"AC-pauta-revelavel-08"},
    {"do":"press","key":"PageDown","boundary":{"method":"PUT","url":"/\\/api\\/rundowns\\/.+\\/sheet/","status":200},"boundary_wait":5000,"ac":"AC-pauta-revelavel-22"},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura|Tema do dia","ac":"AC-pauta-revelavel-22"},
    {"do":"click","target":"role=button[name=\"Revelar próximo\"]","ac":"AC-pauta-revelavel-22"},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.dataset.depth + ':' + b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"0:Abertura|0:Tema do dia|1:Contexto","ac":"AC-pauta-revelavel-22","note":"crossing levels"},
    {"do":"press","key":"PageUp","ac":"AC-pauta-revelavel-23"},
    {"do":"wait","ms":400},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura|Tema do dia","ac":"AC-pauta-revelavel-23"},
    {"do":"click","target":"role=button[name=\"Ocultar último\"]","ac":"AC-pauta-revelavel-23"},
    {"do":"wait","ms":400},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura","ac":"AC-pauta-revelavel-23"},
    {"do":"press","key":"PageUp","ac":"AC-pauta-revelavel-23"},
    {"do":"expect","target":"testid=toast","contains":"Nada foi revelado nesta tomada ainda.","ac":"AC-pauta-revelavel-23"},
    {"do":"press","key":"Shift+PageDown","ac":"AC-pauta-revelavel-24"},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura|Tema do dia|Contexto|Detalhe do contexto|Exemplo","ac":"AC-pauta-revelavel-24"},
    {"do":"expect","target":"testid=toast","contains":"Tópico revelado com 3 sub-itens. PgUp oculta o grupo.","ac":"AC-pauta-revelavel-24"},
    {"do":"press","key":"PageUp","ac":"AC-pauta-revelavel-24"},
    {"do":"wait","ms":400},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura","ac":"AC-pauta-revelavel-24","note":"one PageUp hides the whole group"},
    {"do":"press","key":"F2","ac":"AC-pauta-revelavel-28"},
    {"do":"expect","target":"testid=preparation-strip","contains":"Preparo ligado","ac":"AC-pauta-revelavel-28"},
    {"do":"expect","target":"testid=sheet-block","count":10,"ac":"AC-pauta-revelavel-28"},
    {"do":"expect","target":"css=.block.ghost","count":9,"ac":"AC-pauta-revelavel-28"},
    {"do":"expect","target":"testid=block-planned>>first","text":"começa visível","ac":"AC-pauta-revelavel-28"},
    {"do":"click","target":"testid=block-collapse>>first","ac":"AC-pauta-revelavel-43"},
    {"do":"expect","target":"testid=collapsed-note","text":"3 sub-itens recolhidos","ac":"AC-pauta-revelavel-43"},
    {"do":"expect","target":"testid=sheet-block","count":7,"ac":"AC-pauta-revelavel-43"},
    {"do":"click","target":"testid=block-collapse>>first","ac":"AC-pauta-revelavel-43"},
    {"do":"expect","target":"testid=sheet-block","count":10,"ac":"AC-pauta-revelavel-43"},
    {"do":"click","target":"testid=block-planned>>last","boundary":{"method":"PUT","url":"/\\/api\\/rundowns\\/.+\\/sheet/","status":200},"boundary_wait":5000,"ac":"AC-pauta-revelavel-28","note":"Encerramento now starts visible in every take"},
    {"do":"expect","target":"testid=block-planned>>last","text":"começa visível","ac":"AC-pauta-revelavel-28"},
    {"do":"click","target":"role=button[name=\"Preparo\"]","ac":"AC-pauta-revelavel-28"},
    {"do":"expect","hidden":"testid=preparation-strip","ac":"AC-pauta-revelavel-28"},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura","ac":["AC-pauta-revelavel-28","AC-pauta-revelavel-21"],"note":"the plan changed, the take did not"},
    {"do":"click","target":"role=textbox[name=\"Texto do bloco\"]>>first"},
    {"do":"press","key":"End","target":"role=textbox[name=\"Texto do bloco\"]>>first"},
    {"do":"press","key":"PageDown","target":"role=textbox[name=\"Texto do bloco\"]>>first","ac":"AC-pauta-revelavel-26"},
    {"do":"press","key":"PageDown","target":"role=textbox[name=\"Texto do bloco\"]>>first","ac":"AC-pauta-revelavel-26"},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura|Tema do dia|Contexto","ac":"AC-pauta-revelavel-26","note":"the caret stayed in Abertura and nothing was inserted"},
    {"do":"eval","expression":"document.activeElement.textContent","equals":"Abertura","ac":"AC-pauta-revelavel-26"},
    {"do":"press","key":"Escape","ac":"AC-pauta-revelavel-53"},
    {"do":"click","target":"testid=block-eye>>nth=1","boundary":{"method":"PUT","url":"/\\/api\\/rundowns\\/.+\\/sheet/","status":200},"boundary_wait":5000,"ac":"AC-pauta-revelavel-25","note":"the eye of Tema do dia"},
    {"do":"expect","target":"testid=toast","contains":"Tópico oculto junto com os sub-itens. Ele volta com PgDn.","ac":"AC-pauta-revelavel-25"},
    {"do":"wait","ms":400},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura","ac":["AC-pauta-revelavel-25","AC-pauta-revelavel-31"]},
    {"do":"expect","target":"testid=sheet-counter","contains":"1 de 10","ac":"AC-pauta-revelavel-31"},
    {"do":"press","key":"PageDown","ac":"AC-pauta-revelavel-22"},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura|Tema do dia|Contexto","ac":"AC-pauta-revelavel-22","note":"Tema do dia comes back with the sub-items still in the take"},
    {"do":"wait","ms":1500},
    {"do":"reload","ac":"AC-pauta-revelavel-30"},
    {"do":"wait","target":"testid=sheet-ruler"},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura|Tema do dia|Contexto","ac":"AC-pauta-revelavel-30","note":"the progress of the take came back from disk"},
    {"do":"click","target":"role=button[name=\"Nova tomada\"]","ac":"AC-pauta-revelavel-29"},
    {"do":"expect","target":"role=dialog[name=\"Começar uma nova tomada?\"]","contains":"2 visíveis e 8 ocultos. Nenhum conteúdo é apagado.","ac":"AC-pauta-revelavel-29"},
    {"do":"click","target":"role=button[name=\"Cancelar\"]","ac":"AC-pauta-revelavel-29"},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura|Tema do dia|Contexto","ac":"AC-pauta-revelavel-29","note":"cancel keeps the progress"},
    {"do":"click","target":"role=button[name=\"Nova tomada\"]","ac":"AC-pauta-revelavel-29"},
    {"do":"click","target":"css=[role=\"dialog\"] button.btn-primary","boundary":{"method":"PUT","url":"/\\/api\\/rundowns\\/.+\\/sheet/","status":200},"boundary_wait":5000,"ac":"AC-pauta-revelavel-29"},
    {"do":"expect","target":"testid=toast","contains":"Nova tomada. PgDn revela o primeiro bloco.","ac":"AC-pauta-revelavel-29"},
    {"do":"eval","expression":"[...document.querySelectorAll('[data-testid=sheet-block]')].map((b) => b.querySelector('[data-testid=block-text]').textContent).join('|')","equals":"Abertura|Encerramento","ac":["AC-pauta-revelavel-29","AC-pauta-revelavel-21"],"note":"back to the plan, with Encerramento now planned visible"},
    {"do":"press","key":"Shift+PageDown"},
    {"do":"press","key":"Shift+PageDown"},
    {"do":"press","key":"Shift+PageDown"},
    {"do":"expect","target":"testid=sheet-end","text":"Fim da pauta · tudo na tela","ac":"AC-pauta-revelavel-32"},
    {"do":"expect","target":"testid=sheet-counter","contains":"10 de 10","ac":"AC-pauta-revelavel-32"},
    {"do":"press","key":"PageDown","ac":"AC-pauta-revelavel-22"},
    {"do":"expect","target":"testid=toast","contains":"Tudo já está na tela.","ac":"AC-pauta-revelavel-22"},
    {"do":"screenshot","name":"reveal-and-take"}
  ]
}
