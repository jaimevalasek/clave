{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "aioson hooks:emit \"$PWD\" --agent='dev' --source='antigravity' 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "aioson hooks:emit \"$PWD\" --agent='dev' --source='antigravity' 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Task|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "aioson hooks:emit \"$PWD\" --agent='dev' --source='antigravity' 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "aioson hooks:emit \"$PWD\" --then=agent:done --agent='dev' --source='antigravity' 2>/dev/null || true"
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "aioson hooks:emit \"$PWD\" --agent='dev' --source='antigravity' --event=SessionEnd 2>/dev/null || true"
      }
    ]
  }
}