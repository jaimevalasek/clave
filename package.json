{
  "name": "clave",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pauta viva para lives — módulo do AIOSON Play",
  "scripts": {
    "dev": "concurrently --names backend,frontend --prefix-colors blue,magenta \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch server/src/main.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc -p server/tsconfig.json && vite build",
    "start": "concurrently --names backend,frontend --prefix-colors blue,magenta \"pnpm:start:server\" \"pnpm:start:web\"",
    "start:server": "node server/dist/server/src/main.js",
    "start:web": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
